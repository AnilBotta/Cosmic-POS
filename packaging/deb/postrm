#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "nodedr-orderrestro: your data stays in Docker volumes (nodedr-orderrestro_pg_data, nodedr-orderrestro_uploads_data, nodedr-orderrestro_state) and your settings in /etc/nodedr-orderrestro/nodedr-orderrestro.env. Remove them only if you are sure." >&2
fi
exit 0
